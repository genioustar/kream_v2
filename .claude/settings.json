{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "TMPDIR": "/private/tmp/claude-501/-Users-ny-Documents-programs-resell-sniper/"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-tmp-writes.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit*)",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/push-after-commit.sh",
            "timeout": 60,
            "statusMessage": "커밋 push 중..."
          }
        ]
      }
    ]
  }
}
